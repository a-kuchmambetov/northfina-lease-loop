// A signed contract: the lease terms locked at signing (CHALLENGE.md Spine #4).
// A price-list change after this row exists must never change its net rent or buyout —
// only the VAT on each invoice stays unlocked (see src/domain/invoicing.ts).
model Contract {
  id                     String   @id
  asset_id               String
  customer_id            String
  start_date             String // ISO YYYY-MM-DD; also invoice #1's due date
  term_months            Int
  price_list_version     Int
  list_price_cents       Int
  down_payment_cents     Int
  financed_cents         Int
  monthly_net_rent_cents Int
  buyout_cents           Int
  signed_at              DateTime @default(now())

  @@index([asset_id])
  @@index([customer_id])
}

// A real invoice, issued once its due date arrives (CHALLENGE.md Spine #5). Unlike the
// full projected schedule src/domain/invoicing.ts can compute at any time, a row here only
// exists once it is actually due — so its VAT rate is frozen at issuance, never recomputed.
// See src/server/features/contracts/issue-invoices.ts for how and when a row is created.
model Invoice {
  id               String    @id
  contract_id      String
  sequence_number  Int
  due_date         String // ISO YYYY-MM-DD
  payment_deadline String // ISO YYYY-MM-DD; due_date + the payment term (see src/domain/invoicing.ts)
  net_cents        Int
  vat_rate_percent Float
  vat_cents        Int
  gross_cents      Int
  status           String // issued | paid
  issued_at        DateTime  @default(now())
  paid_at          DateTime?

  @@unique([contract_id, sequence_number])
  @@index([contract_id])
}

