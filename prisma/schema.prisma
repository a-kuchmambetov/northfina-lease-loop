// Database schema. Change it, then run `npm run db:migrate -- --name <what_changed>`.
// Never hand-write files in prisma/migrations/: the Prisma CLI generates them.
// SQLite has no enums here, so allowed values (category, condition, status) are
// checked with Zod in src/data/schemas.ts before anything is written.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One physical item that can be leased, returned, refurbished and leased again.
// Mirrors data/assets.json; `usage` is stored as two columns.
model Asset {
  id             String   @id
  category       String // e_bike | laptop | farm_machine
  make           String
  model          String
  model_year     Int
  serial_number  String   @unique
  condition      String // new | like_new | good | fair | poor
  usage_unit     String // km | battery_cycles | engine_hours
  usage_value    Int
  previous_lives Int
  status         String // available | reserved | returned
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([category])
}

// A signed contract: the lease terms locked at signing (CHALLENGE.md Spine #4).
// A price-list change after this row exists must never change its net rent or buyout —
// only the VAT on each invoice stays unlocked (see src/domain/invoicing.ts).
model Contract {
  id                     String   @id
  asset_id               String
  customer_id            String
  start_date             String // ISO YYYY-MM-DD; also invoice #1's due date
  term_months            Int
  price_list_version     Int
  list_price_cents       Int
  down_payment_cents     Int
  financed_cents         Int
  monthly_net_rent_cents Int
  buyout_cents           Int
  status                 String   @default("active") // active | bought | returned (CHALLENGE.md Spine #6)
  signed_at              DateTime @default(now())

  @@index([asset_id])
  @@index([customer_id])
}

// A real invoice, issued once its due date arrives (CHALLENGE.md Spine #5). Unlike the
// full projected schedule src/domain/invoicing.ts can compute at any time, a row here only
// exists once it is actually due — so its VAT rate is frozen at issuance, never recomputed.
// See src/server/features/contracts/issue-invoices.ts for how and when a row is created.
model Invoice {
  id               String    @id
  contract_id      String
  sequence_number  Int
  due_date         String // ISO YYYY-MM-DD
  payment_deadline String // ISO YYYY-MM-DD; due_date + the payment term (see src/domain/invoicing.ts)
  net_cents        Int
  vat_rate_percent Float
  vat_cents        Int
  gross_cents      Int
  status           String // issued | paid
  issued_at        DateTime  @default(now())
  paid_at          DateTime?

  @@unique([contract_id, sequence_number])
  @@index([contract_id])
}

// An in-progress or decided application (CHALLENGE.md Spine #3): the question-flow answers
// collected so far and the eligibility decision, once there is one. Persisted (not kept in
// memory) because a `manual_review` decision needs a durable record for a human to review
// later, and the multi-step question flow needs state across separate HTTP requests.
// `financed_amount_cents`, `monthly_rent_with_vat_cents` and `price_list_version` are the
// quote looked up when the application started — locked the same way Contract locks its
// own price, so a price-list change mid-application cannot change the deal being decided.
model Application {
  id                          String    @id
  customer_id                 String
  asset_id                    String
  term_months                 Int
  financed_amount_cents       Int
  monthly_rent_with_vat_cents Int
  price_list_version          Int
  answers_json                String // JSON object of questionId -> answer
  decision                    String // pending | approved | rejected | manual_review
  decision_reason             String?
  created_at                  DateTime  @default(now())
  decided_at                  DateTime?

  @@index([customer_id])
}

// A ledger entry for a customer's credit balance: positive when earned (e.g. a pass_on
// bonus), negative when spent (applied as part of a down payment at signing). The balance
// is the sum of a customer's rows — see src/server/customer-credit.ts.
model CustomerCredit {
  id                  String   @id
  customer_id         String
  amount_cents        Int // positive = earned, negative = spent
  reason              String // e.g. pass_on_bonus | applied_to_down_payment
  related_contract_id String?
  created_at          DateTime @default(now())

  @@index([customer_id])
}

// Who changed what, and when. Written in the same transaction as the change
// (see src/server/audit.ts), so a change without an audit row cannot exist.
model AuditLog {
  id           Int      @id @default(autoincrement())
  created_at   DateTime @default(now())
  actor        String
  action       String // e.g. asset.status_changed
  entity_type  String // e.g. asset
  entity_id    String
  details_json String? // JSON text, e.g. {"from":"available","to":"reserved"}

  @@index([entity_type, entity_id])
  @@index([created_at])
}
